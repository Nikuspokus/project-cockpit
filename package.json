{
  "name": "project-cockpit",
  "displayName": "Project Cockpit",
  "description": "Un seul panneau, zéro configuration : lancez les commandes du projet, gérez les ports occupés et vérifiez votre .env (JS/TS et Java).",
  "version": "0.1.0",
  "publisher": "nikuspokus",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "scripts",
    "ports",
    "env",
    "npm",
    "maven",
    "gradle",
    "docker-compose",
    "monorepo"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts",
    "workspaceContains:**/Makefile",
    "workspaceContains:**/docker-compose.yml",
    "workspaceContains:**/docker-compose.yaml",
    "workspaceContains:**/compose.yml",
    "workspaceContains:**/compose.yaml",
    "workspaceContains:**/.env"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cockpit",
          "title": "Cockpit",
          "icon": "media/cockpit.svg"
        }
      ]
    },
    "views": {
      "cockpit": [
        {
          "id": "cockpit.view",
          "name": "Cockpit"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "cockpit",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant interne de la commande Cockpit."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "cockpit.refresh",
        "title": "Actualiser",
        "category": "Cockpit",
        "icon": "$(refresh)"
      },
      {
        "command": "cockpit.runCommand",
        "title": "Lancer",
        "category": "Cockpit",
        "icon": "$(play)"
      },
      {
        "command": "cockpit.rerunCommand",
        "title": "Relancer",
        "category": "Cockpit",
        "icon": "$(debug-restart)"
      },
      {
        "command": "cockpit.stopCommand",
        "title": "Stop",
        "category": "Cockpit",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "cockpit.runCommand", "when": "false" },
        { "command": "cockpit.rerunCommand", "when": "false" },
        { "command": "cockpit.stopCommand", "when": "false" }
      ],
      "view/title": [
        {
          "command": "cockpit.refresh",
          "when": "view == cockpit.view",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "cockpit.runCommand",
          "when": "view == cockpit.view && viewItem == cockpit.command.idle",
          "group": "inline@1"
        },
        {
          "command": "cockpit.rerunCommand",
          "when": "view == cockpit.view && viewItem == cockpit.command.running",
          "group": "inline@1"
        },
        {
          "command": "cockpit.stopCommand",
          "when": "view == cockpit.view && viewItem == cockpit.command.running",
          "group": "inline@2"
        }
      ]
    }
  },
  "homepage": "https://nikuspokus.github.io/project-cockpit",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikuspokus/project-cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/Nikuspokus/project-cockpit/issues"
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "ovsx": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
