{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "label": "npm: watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[watch\\]|build started",
          "endsPattern": "\\[watch\\]|build finished|Done in"
        }
      },
      "presentation": { "reveal": "silent" }
    }
  ]
}
